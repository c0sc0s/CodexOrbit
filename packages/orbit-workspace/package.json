{
  "name": "@c0sc0s/orbit-workspace",
  "version": "0.1.0",
  "description": "Better Work Tree: inspect the active worktree, branch and working directory from the Codex composer.",
  "type": "module",
  "files": [
    "runtime/",
    "dist/service/",
    "dist/shared/",
    ".codex-plugin/",
    "orbit-plugin.json",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node ../../scripts/clean-build.mjs && tsc -p tsconfig.node.json && tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "7.29.8",
    "@c0sc0s/orbit": "0.5.4",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@c0sc0s/orbit-tags": "0.9.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.19",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.0",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
